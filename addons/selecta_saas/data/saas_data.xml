<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_saas_invoice" model="ir.sequence">
            <field name="name">Factures d'abonnement SELECTA</field>
            <field name="code">selecta.saas.invoice</field>
            <field name="prefix">ABO-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Grille par défaut : modifiable depuis l'administration centrale (Catégories et tarifs). -->
        <record id="plan_ecole" model="selecta.saas.plan">
            <field name="name">École / ONG</field>
            <field name="code">ecole_ong</field>
            <field name="sequence">10</field>
            <field name="audience">Écoles, universités, associations, ONG</field>
            <field name="description">Tests d'admission, examens internes et sélections de bénévoles.</field>
            <field name="price_monthly">29</field>
            <field name="price_yearly">290</field>
            <field name="max_active_concours">3</field>
            <field name="max_candidates_month">300</field>
            <field name="max_staff">5</field>
            <field name="feature_ai_analysis" eval="True"/>
            <field name="support">Par e-mail</field>
        </record>
        <record id="plan_pme" model="selecta.saas.plan">
            <field name="name">PME</field>
            <field name="code">pme</field>
            <field name="sequence">20</field>
            <field name="audience">PME, cabinets de recrutement, centres de formation</field>
            <field name="description">Recrutements réguliers avec votre identité visuelle.</field>
            <field name="price_monthly">79</field>
            <field name="price_yearly">790</field>
            <field name="max_active_concours">10</field>
            <field name="max_candidates_month">1500</field>
            <field name="max_staff">15</field>
            <field name="feature_ai_analysis" eval="True"/>
            <field name="feature_branding" eval="True"/>
            <field name="highlight" eval="True"/>
            <field name="support">E-mail et téléphone</field>
        </record>
        <record id="plan_grande" model="selecta.saas.plan">
            <field name="name">Grande entreprise</field>
            <field name="code">grande_entreprise</field>
            <field name="sequence">30</field>
            <field name="audience">Groupes, banques, opérateurs, multinationales</field>
            <field name="description">Campagnes de recrutement à grande échelle, plusieurs centres d'examen.</field>
            <field name="price_monthly">199</field>
            <field name="price_yearly">1990</field>
            <field name="max_active_concours">0</field>
            <field name="max_candidates_month">10000</field>
            <field name="max_staff">50</field>
            <field name="feature_ai_analysis" eval="True"/>
            <field name="feature_llm" eval="True"/>
            <field name="feature_branding" eval="True"/>
            <field name="support">Prioritaire</field>
        </record>
        <record id="plan_public" model="selecta.saas.plan">
            <field name="name">Administration publique</field>
            <field name="code">administration</field>
            <field name="sequence">40</field>
            <field name="audience">Ministères, concours d'État, établissements publics</field>
            <field name="description">Concours nationaux, volumes illimités, procès-verbaux scellés.</field>
            <field name="price_monthly">349</field>
            <field name="price_yearly">3490</field>
            <field name="max_active_concours">0</field>
            <field name="max_candidates_month">0</field>
            <field name="max_staff">0</field>
            <field name="feature_ai_analysis" eval="True"/>
            <field name="feature_llm" eval="True"/>
            <field name="feature_branding" eval="True"/>
            <field name="support">Prioritaire, interlocuteur dédié</field>
        </record>

        <record id="param_payment_instructions" model="ir.config_parameter">
            <field name="key">selecta_saas.payment_instructions</field>
            <field name="value">Mobile Money (M-Pesa, Airtel Money, Orange Money) : +243 828 317 540 — bénéficiaire Naxoris.
Indiquez le numéro de facture en motif, puis déclarez votre paiement avec la référence reçue par SMS.</field>
        </record>
        <record id="param_support_email" model="ir.config_parameter">
            <field name="key">selecta_saas.support_email</field>
            <field name="value">contact@naxoris.com</field>
        </record>
        <record id="param_support_phone" model="ir.config_parameter">
            <field name="key">selecta_saas.support_phone</field>
            <field name="value">+243 828 317 540 · +243 831 509 420</field>
        </record>
    </data>

    <record id="cron_saas_lifecycle" model="ir.cron">
        <field name="name">SELECTA SaaS : fin d'essai et échéances d'abonnement</field>
        <field name="model_id" ref="model_selecta_saas_tenant"/>
        <field name="state">code</field>
        <field name="code">model._cron_lifecycle()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
