                        </nav>
                    </div>
                </footer>

                <script>
                    (function () {
                        var section = document.getElementById("tarifs");
                        if (!section) { return; }
                        var buttons = section.querySelectorAll(".lp-cycle-btn");
                        buttons.forEach(function (btn) {
                            btn.addEventListener("click", function () {
                                var cycle = btn.getAttribute("data-cycle");
                                section.setAttribute("data-cycle", cycle);
                                buttons.forEach(function (b) { b.setAttribute("aria-pressed", String(b === btn)); });
                            });
                        });
                    })();
                </script>
            </body>
