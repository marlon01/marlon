<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Deux applications autonomes supplémentaires servies par le gabarit commun de SELECTA. -->
    <template id="selecta_layout_saas" inherit_id="selecta_concours.selecta_layout" name="SELECTA layout (SaaS)">
        <xpath expr="//script[@id='selecta-config']" position="before">
            <t t-if="app == 'signup'"><t t-call-assets="selecta_saas.assets_signup" t-js="false"/></t>
            <t t-if="app == 'platform'"><t t-call-assets="selecta_saas.assets_platform" t-js="false"/></t>
        </xpath>
        <xpath expr="//script[@id='selecta-config']" position="after">
            <t t-if="app == 'signup'"><t t-call-assets="selecta_saas.assets_signup" t-css="false"/></t>
            <t t-if="app == 'platform'"><t t-call-assets="selecta_saas.assets_platform" t-css="false"/></t>
        </xpath>
    </template>

    <!-- Montant « à la française » : 3 490 ou 24,17 (variable attendue : amount). -->
    <template id="lp_amount" name="SELECTA — montant">
        <t t-set="_int" t-value="int(amount or 0)"/>
        <t t-set="_cents" t-value="int(round(((amount or 0) - _int) * 100))"/>
        <t t-out="(str(_int) if _int &lt; 1000 else '%s&#160;%03d' % (_int // 1000, _int % 1000)) + ((',%02d' % _cents) if _cents else '')"/>
    </template>

    <!-- Bouton d'appel à l'action : essai gratuit ou contact lorsque les inscriptions sont fermées. -->
    <template id="lp_cta" name="SELECTA — appel à l'action">
        <a t-if="signup_enabled" t-att-class="cta_class" t-att-href="cta_href or '/selecta/signup'"><t t-out="cta_label"/></a>
        <a t-else="" t-att-class="cta_class" t-att-href="'mailto:' + contact_email + '?subject=Ouverture%20d%27un%20espace%20SELECTA'">Nous contacter</a>
    </template>

    <template id="landing" name="SELECTA — présentation">
        <t t-set="contact_email" t-value="support_email or 'contact@naxoris.com'"/>
        <t t-set="issuer" t-value="issuer or 'Naxoris'"/>
        <t t-set="phones" t-value="[p.strip() for p in (support_phone or '').split('·') if p.strip()]"/>
        <t t-set="meta_desc" t-value="'SELECTA organise vos concours et tests de recrutement en ligne avec intégrité : épreuves chronométrées, surveillance IA par webcam, résultats immédiats et procès-verbal scellé vérifiable. Essai gratuit de %s jours, sans carte bancaire.' % trial_days"/>
        <html lang="fr">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
                <title>SELECTA — Concours et tests de recrutement en ligne, sécurisés et vérifiables</title>
                <meta name="description" t-att-content="meta_desc"/>
                <meta name="theme-color" content="#14213D"/>
                <meta property="og:type" content="website"/>
                <meta property="og:locale" content="fr_FR"/>
                <meta property="og:site_name" content="SELECTA"/>
                <meta property="og:title" content="SELECTA — des concours en ligne aux résultats incontestables"/>
                <meta property="og:description" t-att-content="meta_desc"/>
                <link rel="icon" href="/selecta_concours/static/description/icon.png"/>
                <link rel="stylesheet" href="/selecta_concours/static/src/css/selecta_base.css"/>
                <link rel="stylesheet" href="/selecta_saas/static/src/css/saas_public.css"/>
                <script src="/selecta_saas/static/src/public/selecta_i18n.js"/>
            </head>
            <body class="lp">
                <a class="lp-skip" href="#contenu">Aller au contenu</a>

                <!-- ============================================================ barre supérieure -->
                <header class="lp-top">
                    <div class="lp-container lp-top-in">
                        <a class="lp-mark" href="/selecta" aria-label="SELECTA, accueil">
                            <span class="lp-mark-seal" aria-hidden="true">S</span>
                            <span class="lp-mark-word">SELECTA</span>
                        </a>
                        <nav class="lp-nav" aria-label="Navigation principale">
                            <a href="#fonctionnalites">Fonctionnalités</a>
                            <a href="#tarifs">Tarifs</a>
                            <a href="#faq">FAQ</a>
                        </nav>
                        <div class="lp-top-actions">
                            <div class="sl-lang-switch" role="group" aria-label="Langue / Language" data-no-i18n=""><button type="button" data-selecta-lang="fr" lang="fr">FR</button><button type="button" data-selecta-lang="en" lang="en">EN</button></div>
                            <a class="lp-top-link lp-hide-s" href="/selecta/exam">Espace candidat</a>
                            <a class="lp-top-link" href="/selecta/login">Se connecter</a>
                            <t t-call="selecta_saas.lp_cta">
                                <t t-set="cta_class" t-value="'sl-btn sl-btn-primary sl-btn-sm lp-top-cta'"/>
                                <t t-set="cta_label" t-value="'Essai gratuit'"/>
                            </t>
                            <details class="lp-menu">
                                <summary aria-label="Ouvrir le menu">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
                                </summary>
                                <nav class="lp-menu-panel" aria-label="Menu">
                                    <a href="#fonctionnalites">Fonctionnalités</a>
                                    <a href="#fonctionnement">Fonctionnement</a>
                                    <a href="#tarifs">Tarifs</a>
                                    <a href="#securite">Sécurité</a>
                                    <a href="#faq">FAQ</a>
                                    <hr/>
                                    <a href="/selecta/exam">Espace candidat</a>
                                    <a href="/selecta/login">Se connecter</a>
                                </nav>
                            </details>
                        </div>
                    </div>
                </header>

                <main id="contenu">
                    <!-- ======================================================== héros -->
                    <section class="lp-hero" aria-labelledby="lp-h1">
                        <div class="lp-container lp-hero-in">
                            <div class="lp-hero-text">
                                <p class="lp-eyebrow">Concours et tests de recrutement en ligne</p>
                                <h1 id="lp-h1">Des concours en ligne dont personne ne peut contester les résultats.</h1>
                                <p class="lp-lede">Entreprises, écoles et administrations organisent avec SELECTA leurs concours et tests de recrutement en ligne, en toute intégrité&#160;: épreuves chronométrées, surveillance IA par webcam, résultats immédiats et procès-verbal scellé, vérifiable par tous.</p>
                                <div class="lp-hero-cta">
                                    <t t-call="selecta_saas.lp_cta">
                                        <t t-set="cta_class" t-value="'sl-btn sl-btn-primary sl-btn-lg'"/>
                                        <t t-set="cta_label" t-value="'Démarrer l’essai gratuit de %s jours' % trial_days"/>
                                    </t>
                                    <a class="sl-btn sl-btn-lg lp-btn-quiet" href="#tarifs">Voir les tarifs</a>
                                </div>
                                <p class="lp-hero-note" t-if="signup_enabled">Sans carte bancaire · Votre espace est créé immédiatement</p>
                                <p class="lp-hero-note" t-else="">Les inscriptions en ligne sont momentanément fermées : écrivez-nous, nous ouvrons votre espace.</p>
                                <ul class="lp-proof">
                                    <li><strong>Chronomètre</strong>sous l’autorité du serveur</li>
                                    <li><strong>Vision 100&#160;% locale</strong>aucun flux vidéo transmis</li>
                                    <li><strong>Empreinte SHA-256</strong>et QR code de vérification</li>
                                </ul>
                            </div>

                            <!-- Visuel : extrait de procès-verbal scellé (illustratif). -->
                            <figure class="lp-pv" role="img" aria-label="Illustration : procès-verbal de résultats scellé par SELECTA, avec classement, empreinte SHA-256, QR code et sceau de vérification.">
                                <div class="lp-pv-sheet" aria-hidden="true">
                                    <div class="lp-pv-head">
