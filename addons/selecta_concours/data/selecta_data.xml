<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_selecta_concours" model="ir.sequence">
            <field name="name">Référence concours SELECTA</field>
            <field name="code">selecta.concours</field>
            <field name="prefix">CNC-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

    <record id="cron_selecta_housekeeping" model="ir.cron">
        <field name="name">SELECTA : expiration des épreuves et clôtures automatiques</field>
        <field name="model_id" ref="model_selecta_concours"/>
        <field name="state">code</field>
        <field name="code">model._cron_housekeeping()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_selecta_purge_biometrics" model="ir.cron">
        <field name="name">SELECTA : effacement des données biométriques échues</field>
        <field name="model_id" ref="model_selecta_concours"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge_biometrics()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_selecta_throttle_cleanup" model="ir.cron">
        <field name="name">SELECTA : purge des verrous de connexion</field>
        <field name="model_id" ref="model_selecta_login_throttle"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
