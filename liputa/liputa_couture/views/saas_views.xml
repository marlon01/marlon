<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_plan_list" model="ir.ui.view">
        <field name="name">liputa.plan.list</field>
        <field name="model">liputa.plan</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="price"/>
                <field name="currency_id"/>
                <field name="interval_months"/>
                <field name="trial_days"/>
                <field name="grace_days"/>
                <field name="max_users"/>
                <field name="ai_credits_month"/>
            </list>
        </field>
    </record>
    <record id="action_plan" model="ir.actions.act_window">
        <field name="name">Plans</field>
        <field name="res_model">liputa.plan</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_subscription_list" model="ir.ui.view">
        <field name="name">liputa.subscription.list</field>
        <field name="model">liputa.subscription</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'suspended'" decoration-warning="state == 'grace'">
                <field name="company_id"/>
                <field name="plan_id"/>
                <field name="state" widget="badge"/>
                <field name="next_due_date"/>
                <field name="days_left"/>
                <field name="ai_credits_used"/>
            </list>
        </field>
    </record>
    <record id="view_subscription_form" model="ir.ui.view">
        <field name="name">liputa.subscription.form</field>
        <field name="model">liputa.subscription</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"
                           groups="liputa_couture.group_liputa_saas_admin"/>
                </header>
                <sheet>
                    <h1><field name="company_id" readonly="1"/></h1>
                    <group>
                        <group>
                            <field name="plan_id"/>
                            <field name="start_date"/>
                            <field name="next_due_date"/>
                            <field name="days_left"/>
                        </group>
                        <group>
                            <field name="last_payment_date"/>
                            <field name="ai_credits_used"/>
                            <field name="ai_period_start"/>
                            <field name="signup_ip"/>
                        </group>
                    </group>
                    <field name="payment_ids">
                        <list editable="bottom">
                            <field name="reference"/>
                            <field name="date"/>
                            <field name="method"/>
                            <field name="phone"/>
                            <field name="amount"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="provider_reference"/>
                            <field name="state" widget="badge"/>
                            <button name="action_confirm" type="object" string="Confirm" invisible="state != 'pending'"
                                    groups="liputa_couture.group_liputa_saas_admin"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">liputa.subscription</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_my_subscription" model="ir.actions.server">
        <field name="name">My subscription</field>
        <field name="model_id" ref="model_liputa_subscription"/>
        <field name="state">code</field>
        <field name="code">sub = env['liputa.subscription'].search([('company_id', '=', env.company.id)], limit=1)
action = {"type": "ir.actions.act_window", "res_model": "liputa.subscription", "res_id": sub.id, "view_mode": "form", "target": "current"}</field>
    </record>

    <record id="action_ai_settings" model="ir.actions.act_window">
        <field name="name">Integrations (AI, SMS, payments)</field>
        <field name="res_model">ir.config_parameter</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('key', '=like', 'liputa.%')]</field>
    </record>
</odoo>
