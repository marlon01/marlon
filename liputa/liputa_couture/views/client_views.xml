<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Modération des avis clients (administrateurs de la plateforme). -->
    <record id="view_review_list" model="ir.ui.view">
        <field name="name">liputa.review.list</field>
        <field name="model">liputa.review</field>
        <field name="arch" type="xml">
            <list editable="top" create="0" decoration-muted="not is_published">
                <field name="create_date" string="Date" readonly="1"/>
                <field name="company_id" readonly="1"/>
                <field name="author_name" readonly="1"/>
                <field name="user_id" readonly="1" optional="hide"/>
                <field name="rating" readonly="1"/>
                <field name="comment" readonly="1"/>
                <field name="verified" readonly="1"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_review_search" model="ir.ui.view">
        <field name="name">liputa.review.search</field>
        <field name="model">liputa.review</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_id"/>
                <field name="comment"/>
                <filter name="hidden" string="Hidden" domain="[('is_published', '=', False)]"/>
                <filter name="low" string="1 or 2 stars" domain="[('rating', '&lt;=', 2)]"/>
                <filter name="unverified" string="Not verified" domain="[('verified', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_review" model="ir.actions.act_window">
        <field name="name">Client reviews</field>
        <field name="res_model">liputa.review</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_liputa_reviews" name="Client reviews" parent="menu_liputa_saas"
              action="action_review" sequence="7"/>
</odoo>
