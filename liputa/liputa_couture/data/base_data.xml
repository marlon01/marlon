<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Congolese franc available by default -->
        <record id="base.CDF" model="res.currency">
            <field name="active" eval="True"/>
        </record>

        <record id="seq_liputa_order" model="ir.sequence">
            <field name="name">Tailoring order</field>
            <field name="code">liputa.order</field>
            <field name="prefix">CMD/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_liputa_payment" model="ir.sequence">
            <field name="name">Subscription payment</field>
            <field name="code">liputa.subscription.payment</field>
            <field name="prefix">LPT-%(year)s%(month)s-</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="plan_standard" model="liputa.plan">
            <field name="name">Atelier Standard</field>
            <field name="price">5000</field>
            <field name="currency_id" ref="base.CDF"/>
            <field name="interval_months">1</field>
            <field name="trial_days">14</field>
            <field name="grace_days">7</field>
            <field name="max_users">5</field>
            <field name="ai_credits_month">100</field>
        </record>
        <record id="plan_pro" model="liputa.plan">
            <field name="name">Atelier Pro</field>
            <field name="sequence">20</field>
            <field name="price">15000</field>
            <field name="currency_id" ref="base.CDF"/>
            <field name="interval_months">1</field>
            <field name="max_users">20</field>
            <field name="ai_credits_month">500</field>
        </record>

        <!-- Configuration defaults (secrets are set by the operator, never in code) -->
        <record id="icp_ai_provider" model="ir.config_parameter">
            <field name="key">liputa.ai_provider</field>
            <field name="value">none</field>
        </record>
        <record id="icp_ai_model" model="ir.config_parameter">
            <field name="key">liputa.ai_model</field>
            <field name="value">claude-sonnet-5-5</field>
        </record>
        <record id="icp_sms_provider" model="ir.config_parameter">
            <field name="key">liputa.sms_provider</field>
            <field name="value">none</field>
        </record>
    </data>

    <!-- Stages (global) -->
    <data noupdate="1">
        <record id="stage_draft" model="liputa.order.stage">
            <field name="name">Draft</field><field name="client_label">Order registered</field>
            <field name="code">draft</field><field name="sequence">1</field>
        </record>
        <record id="stage_confirmed" model="liputa.order.stage">
            <field name="name">Confirmed</field><field name="client_label">Order confirmed</field>
            <field name="code">confirmed</field><field name="sequence">2</field>
            <field name="notify_client" eval="True"/>
            <field name="mail_template_id" ref="mail_template_order_confirmed"/>
        </record>
        <record id="stage_cutting" model="liputa.order.stage">
            <field name="name">Cutting</field><field name="client_label">Fabric is being cut</field>
            <field name="code">cutting</field><field name="sequence">3</field>
        </record>
        <record id="stage_sewing" model="liputa.order.stage">
            <field name="name">Sewing</field><field name="client_label">Your outfit is being sewn</field>
            <field name="code">sewing</field><field name="sequence">4</field>
        </record>
        <record id="stage_fitting" model="liputa.order.stage">
            <field name="name">Fitting</field><field name="client_label">Ready for fitting</field>
            <field name="code">fitting</field><field name="sequence">5</field>
            <field name="notify_client" eval="True"/>
        </record>
        <record id="stage_finishing" model="liputa.order.stage">
            <field name="name">Finishing</field><field name="client_label">Final touches</field>
            <field name="code">finishing</field><field name="sequence">6</field>
        </record>
        <record id="stage_ready" model="liputa.order.stage">
            <field name="name">Ready</field><field name="client_label">Ready for pick-up</field>
            <field name="code">ready</field><field name="sequence">7</field>
            <field name="notify_client" eval="True"/>
            <field name="mail_template_id" ref="mail_template_order_ready"/>
        </record>
        <record id="stage_delivered" model="liputa.order.stage">
            <field name="name">Delivered</field><field name="client_label">Delivered</field>
            <field name="code">delivered</field><field name="sequence">8</field><field name="fold" eval="True"/>
        </record>
        <record id="stage_cancelled" model="liputa.order.stage">
            <field name="name">Cancelled</field><field name="client_label">Cancelled</field>
            <field name="code">cancelled</field><field name="sequence">9</field><field name="fold" eval="True"/>
            <field name="client_visible" eval="False"/>
        </record>
    </data>

    <!-- Scheduled actions -->
    <data noupdate="1">
        <record id="cron_subscriptions" model="ir.cron">
            <field name="name">Liputa: check subscriptions</field>
            <field name="model_id" ref="model_liputa_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_subscriptions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
        <record id="cron_schedule_watch" model="ir.cron">
            <field name="name">Liputa: watch order deadlines</field>
            <field name="model_id" ref="model_liputa_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_watch_schedule()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
        </record>
    </data>
</odoo>
