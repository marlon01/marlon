    <record id="lib_wax_shirt" model="liputa.garment.model">
        <field name="name">Wax print shirt</field><field name="code">LIB-M-004</field>
        <field name="category_id" ref="cat_men_shirt"/><field name="gender">men</field>
        <field name="pattern_template">shirt</field><field name="sleeve_type">long</field>
        <field name="complexity">2</field><field name="base_hours">5</field>
