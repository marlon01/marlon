        <field name="event_type_ids" eval="[(6, 0, [ref('ev_office'), ref('ev_party'), ref('ev_christmas')])]"/>
        <field name="company_id" eval="False"/><field name="library_state">published</field>
    </record>
    <record id="lib_mourning_dress" model="liputa.garment.model">
        <field name="name">Modest mourning dress</field><field name="code">LIB-W-005</field>
        <field name="category_id" ref="cat_dress"/><field name="gender">women</field>
