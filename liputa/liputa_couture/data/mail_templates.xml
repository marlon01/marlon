<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_order_confirmed" model="mail.template">
        <field name="name">Liputa: order confirmed</field>
        <field name="model_id" ref="model_liputa_order"/>
        <field name="subject">{{ object.company_id.name }} - your order {{ object.name }} is confirmed</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; color:#1F2A44;">
    <p>Hello <t t-out="object.partner_id.name or ''"/>,</p>
    <p>Your order <strong t-out="object.name"/> (<t t-out="object.garment_model_id.name"/>) has been confirmed by
        <t t-out="object.company_id.name"/>.</p>
    <p t-if="object.delivery_date_promised">Expected delivery: <strong t-out="object.delivery_date_promised"/></p>
    <p>Total: <strong t-out="format_amount(object.amount_total, object.currency_id)"/>
        <t t-if="object.deposit_amount"> - deposit: <t t-out="format_amount(object.deposit_amount, object.currency_id)"/></t></p>
    <p style="margin:24px 0;">
        <a t-att-href="object._liputa_tracking_url()"
           style="background:#C4502A;color:#fff;padding:10px 18px;border-radius:6px;text-decoration:none;">Track my order</a>
    </p>
    <p>Thank you for your trust.</p>
</div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="mail_template_order_ready" model="mail.template">
        <field name="name">Liputa: order ready</field>
        <field name="model_id" ref="model_liputa_order"/>
        <field name="subject">{{ object.company_id.name }} - your outfit {{ object.name }} is ready!</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; color:#1F2A44;">
    <p>Hello <t t-out="object.partner_id.name or ''"/>,</p>
    <p>Great news: your <strong t-out="object.garment_model_id.name"/> is ready for pick-up at
        <strong t-out="object.company_id.name"/>.</p>
    <p t-if="object.amount_residual">Balance to pay: <strong t-out="format_amount(object.amount_residual, object.currency_id)"/></p>
    <p t-if="object.company_id.phone">Workshop phone: <t t-out="object.company_id.phone"/></p>
    <p style="margin:24px 0;">
        <a t-att-href="object._liputa_tracking_url()"
           style="background:#1F7A4D;color:#fff;padding:10px 18px;border-radius:6px;text-decoration:none;">See my order</a>
    </p>
</div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
